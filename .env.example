# VORLAGE — hier KEINE echten Keys eintragen! Diese Datei wird ins Repo committet.
# Stattdessen kopieren und die Kopie .env füllen (.env ist in .gitignore):
#   cp .env.example .env
#   # .env mit deinen Keys füllen, dann laden:
#   export $(grep -v '^#' .env | xargs)
#
# Optionaler Online-Detektor (nur aktiv mit --online).
# Standard-Provider: Sightengine — Konto/Keys: https://sightengine.com (Dashboard -> API Keys)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Optional: anderen Provider wählen (Default: sightengine)
# AICHECK_ONLINE_PROVIDER=sightengine
